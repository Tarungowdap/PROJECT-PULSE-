{
  "name": "project-pulse",
  "version": "1.0.0",
  "private": true,
  "description": "Project Pulse: Academic Project Governance, Originality and Milestone Risk Monitor",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/migrate.mjs --seed",
    "db:reset": "node --env-file=.env.local scripts/migrate.mjs --reset --seed",
    "db:embed": "tsx --env-file=.env.local scripts/embed-existing.ts",
    "db:reembed": "tsx --env-file=.env.local scripts/embed-existing.ts --all",
    "mongo:init": "node --env-file=.env.local scripts/mongo-init.mjs",
    "setup": "npm run db:reset && npm run db:embed && npm run mongo:init -- --reset",
    "test:db": "node --env-file=.env.local scripts/db-tests.mjs",
    "test:api": "node --env-file=.env.local scripts/api-tests.mjs",
    "docs:dictionary": "node --env-file=.env.local scripts/gen-data-dictionary.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.6",
    "jose": "^5.9.6",
    "mongoose": "^8.9.0",
    "next": "^15.1.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.6"
  }
}
