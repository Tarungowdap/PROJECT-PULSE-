graph ER {
graph [layout=neato, overlap=false, sep="+14", splines=true, outputorder=edgesfirst, bgcolor=white, fontname="Helvetica", label="ProjectPulse — ER Diagram (Chen notation)\nRectangle = entity · Oval = attribute (underlined = primary key) · Diamond = relationship · 1 / N / M = cardinality", labelloc=t, fontsize=26];
node [fontname="Helvetica"]; edge [color="#555555"];
"DEPARTMENT" [shape=box, style="filled,bold", fillcolor="#cfe8ff", fontsize=18, width=2.2, height=0.7];
"DEPARTMENT.department_id" [shape=ellipse, label=<<u>department_id</u>>, fontsize=12, style=filled, fillcolor="#fff7d6"];
"DEPARTMENT" -- "DEPARTMENT.department_id" [len=1.3];
"DEPARTMENT.name" [shape=ellipse, label="name", fontsize=12, style=filled, fillcolor="#fff7d6"];
"DEPARTMENT" -- "DEPARTMENT.name" [len=1.3];
"DEPARTMENT.code" [shape=ellipse, label="code", fontsize=12, style=filled, fillcolor="#fff7d6"];
"DEPARTMENT" -- "DEPARTMENT.code" [len=1.3];
"USER" [shape=box, style="filled,bold", fillcolor="#cfe8ff", fontsize=18, width=2.2, height=0.7];
