# Copy this file to .env.local (never commit .env.local — it is in .gitignore).

# ---- PostgreSQL (relational data + pgvector) ----
# Matches docker-compose.yml (port 5433). For a local install use your own user/password/port.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/project_pulse

# ---- MongoDB (SRS documents, sections, change history) ----
MONGODB_URI=mongodb://localhost:27017/project_pulse

# ---- Auth ----
# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# ---- Embeddings ----
# minilm (default): all-MiniLM-L6-v2 runs locally, no key needed. First run downloads ~90 MB from Hugging Face.
# openai: needs OPENAI_API_KEY.   hash: offline word-matching fallback (no internet at all).
# Use ONE provider per database; after switching run:  npm run db:reembed
EMBEDDING_PROVIDER=minilm
OPENAI_API_KEY=

# ---- Originality policy ----
# Cosine similarity at/above which a proposal is queued for faculty review (0..1).
# Defaults: 0.6 for minilm/openai, 0.3 for hash. Leave blank to use the default.
SIMILARITY_THRESHOLD=
